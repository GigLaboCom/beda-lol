{
  "name": "@beda/transom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The transom (name board): SVG letters from the font with nails, hangs, falls and breaks; SSR markup, client controller, Astro wrapper",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./Transom.astro": "./src/Transom.astro",
    "./transom.css": "./src/transom.css",
    "./timeline": "./src/timeline.ts"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen": "tsx scripts/gen-glyphs.ts"
  },
  "dependencies": {
    "@beda/core": "workspace:*"
  },
  "devDependencies": {
    "@beda/tokens": "workspace:*",
    "@fontsource/playfair-display": "5.3.0",
    "@types/node": "22.20.4",
    "fontkitten": "1.0.3",
    "happy-dom": "20.14.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "nx": {
    "targets": {
      "gen": {
        "cache": true,
        "inputs": [
          "{projectRoot}/glyphs.config.ts",
          "{projectRoot}/scripts/**/*",
          "{projectRoot}/src/pieces.ts",
          "{projectRoot}/src/geometry.ts",
          "{projectRoot}/src/glyph-analysis.ts",
          "{workspaceRoot}/packages/core/src/breaks.ts",
          "{workspaceRoot}/pnpm-lock.yaml"
        ],
        "outputs": [
          "{projectRoot}/src/glyphs.core.gen.ts",
          "{projectRoot}/src/glyphs.ext.gen.ts",
          "{workspaceRoot}/packages/core/src/charset.gen.ts"
        ]
      }
    }
  }
}
