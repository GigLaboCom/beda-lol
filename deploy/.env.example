# /opt/beda/.env on the server (mode 600): read by the api and backup containers.
# Copy this file and fill it in by hand. Never commit the real file. Values below
# are placeholders. The web container reads /opt/beda/web.env instead (web.env.example).

# --- api ---
BEDA_ENV=prod
BEDA_BASE_URL=https://beda.lol
BEDA_LOG=info
# Supabase Postgres as role beda_api: session pooler (port 5432) or direct connection.
# Never the transaction pooler (6543) — sqlx uses prepared statements.
BEDA_DATABASE_URL=postgresql://beda_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
BEDA_DB_MAX_CONNECTIONS=10
# Supabase project URL: the API verifies access tokens against its JWKS.
BEDA_SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase secret key (Dashboard → Project Settings → API Keys → Secret keys; the legacy
# service_role key works too). Only in this file: the API calls the Auth Admin API with it
# to delete an account. Without it, account deletion answers 503.
BEDA_SUPABASE_SECRET_KEY=sb_secret_<secret-key>
# Optional. Expected token issuer, default <BEDA_SUPABASE_URL>/auth/v1.
# BEDA_JWT_ISSUER=
# Optional. Unsafe requests (POST/PUT/PATCH/DELETE) with a foreign Origin get 403;
# on by default in prod. Extra allowed origins, comma-separated (BEDA_BASE_URL is always allowed).
# BEDA_ORIGIN_CHECK=on
# BEDA_ALLOWED_ORIGINS=

# --- backup (deploy/scripts/backup.sh) ---
# Read access to schemas app and auth (e.g. the postgres role via the session pooler).
BACKUP_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# age public key; the private key is kept offline and supplied only to restore.sh.
BACKUP_AGE_RECIPIENT=age1<public-key>
# rclone destination and S3-compatible storage credentials (rclone env config).
BACKUP_REMOTE=s3:<bucket>/beda
RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=Other
RCLONE_CONFIG_S3_ENDPOINT=https://<s3-endpoint>
RCLONE_CONFIG_S3_ACCESS_KEY_ID=<access-key-id>
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=<secret-access-key>
# Retention (defaults 14 / 8 / 6).
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6
