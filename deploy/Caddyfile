# One address for everything: /api/* goes to the Rust API, the rest to Astro.
# BEDA_SITE_ADDRESS = beda.lol in prod, localhost for `task prod:up`.
# BEDA_TLS_INTERNAL = 1 switches to Caddy's local CA (localhost has no public cert).

(tls-0) {
	# Default: automatic HTTPS from Let's Encrypt.
}

(tls-1) {
	tls internal
}

{$BEDA_SITE_ADDRESS} {
	import tls-{$BEDA_TLS_INTERNAL:0}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	# The cookie banner's region check, as on the sibling GigLabo sites: the shared service
	# (compose profile `shared`) looks the visitor's address up and answers only whether it is
	# in the EU. The address is the one Caddy sees on the connection; headers a visitor could
	# forge are dropped. Only /ip is exposed. Without the service this answers 502, and the
	# banner then asks everyone (src/lib/consent.ts).
	handle /api-shared/ip {
		rewrite * /ip
		reverse_proxy {$BEDA_SHARED_UPSTREAM:shared:8080} {
			header_up -Cf-Connecting-Ip
			header_up -X-Client-Ip
			header_up -X-Forwarded-For
			header_up X-Real-Ip {client_ip}
		}
	}

	handle {
		reverse_proxy web:4321
	}
}
