# /opt/beda/web.env on the server (mode 600): the web container reads only this file.
# Everything here is public by design; secrets stay in /opt/beda/.env (api, backup).
# The public site URL is baked into the image at build time (BEDA_BASE_URL build arg),
# and compose sets BEDA_API_URL=http://api:8080.

# Supabase project URL (the same value as BEDA_SUPABASE_URL in .env) and its
# publishable key (Dashboard → Project Settings → API Keys, `sb_publishable_…`).
# Without both, the site runs with sign-in off.
BEDA_SUPABASE_URL=https://<project-ref>.supabase.co
BEDA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# IndexNow key (S14): any 8–128 characters [a-zA-Z0-9-], served at /<key>.txt.
# Leave empty to answer 404.
BEDA_INDEXNOW_KEY=
