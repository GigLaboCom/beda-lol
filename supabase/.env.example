# supabase/.env (gitignored): read by the Supabase CLI for env() in config.toml.
# Keys of the local OAuth apps (docs/local-dev.md, "OAuth sign-in locally"); each one is
# optional, and a provider without keys only fails when its button is pressed.
# The CLI reads .env from supabase/, not from the repo root.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_X_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_X_SECRET=
