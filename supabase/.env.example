# supabase/.env (gitignored): read by the Supabase CLI for env() in config.toml.
# Keys of the local GitHub OAuth app (docs/local-dev.md, "Sign in with GitHub locally").
# The CLI reads .env from supabase/, not from the repo root.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
