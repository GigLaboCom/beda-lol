---
import { t } from '../i18n/ru';
---

<footer class="foot" id="subscribe">
  <div class="wrap">
    <div>
      <div class="display foot-title">{t('site.name')}</div>
      <p>{t('foot.about')}</p>
    </div>
    <nav aria-label={t('foot.navLabel')}>
      <a href={t('foot.channelHref')}>{t('foot.channel')}</a>
      <a href="/zhurnal">{t('foot.journal')}</a>
      <a href={t('foot.contactHref')}>{t('foot.write')}</a>
    </nav>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    padding: 56px 0 64px;
  }
  .foot .wrap {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .foot-title {
    font-weight: 700;
    font-size: 26px;
  }
  .foot p {
    margin: 8px 0 0;
    color: var(--muted);
    max-width: 34em;
  }
  .foot nav {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }
</style>
