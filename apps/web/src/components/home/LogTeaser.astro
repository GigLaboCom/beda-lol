---
import { t } from '../../i18n/ru';

const entries = [t('log.entryQuote1'), t('log.entryQuote'), t('log.entryQuote')];
---

<section class="section journal" id="journal">
  <div class="wrap">
    <div>
      <p class="kicker">{t('log.kicker')}</p>
      <h2 class="display">{t('log.title')}</h2>
      <p class="lead">{t('log.lead')}</p>
      <svg viewBox="0 0 520 260" width="520" role="img" aria-label={t('log.svgLabel')}>
        <path class="wave" d="M0 200 Q 65 188 130 200 T 260 200 T 390 200 T 520 200"></path>
        <g transform="rotate(18 260 190)">
          <path class="hull" d="M150 170 L370 170 L340 210 L185 210 Z"></path>
          <path class="mast" d="M258 170 L258 40"></path>
          <path class="sail" d="M262 48 L262 160 L350 160 Z"></path>
          <path class="sail-2" d="M254 56 L254 160 L178 160 Z"></path>
        </g>
        <path class="plumb" d="M260 190 L260 70"></path>
        <path class="arc" d="M260 100 A 90 90 0 0 1 288 104"></path>
        <text class="heel" x="298" y="96">{t('log.heel')}</text>
      </svg>
    </div>
    <div class="log">
      {
        entries.map((quote, i) => (
          <Fragment>
            {i > 0 && <hr />}
            <div>
              <div class="d">{t('log.entryDate')}</div>
              <div>{t('log.entryStats')}</div>
              <div class="q">{quote}</div>
            </div>
          </Fragment>
        ))
      }
      <span class="all">{t('log.all')} — {t('common.soon')}</span>
    </div>
  </div>
</section>

<style>
  .journal .wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  h2 {
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.05;
    margin: 14px 0 22px;
  }
  .lead {
    color: var(--text-2);
    font-size: 18px;
    margin: 0 0 20px;
  }
  svg {
    display: block;
  }
  .wave {
    fill: none;
    stroke: var(--sea-wave);
    stroke-width: 2;
  }
  .hull {
    fill: var(--plank);
    stroke: var(--brass);
    stroke-width: 1.5;
  }
  .mast {
    stroke: var(--mast);
    stroke-width: 4;
  }
  .sail {
    fill: var(--canvas);
  }
  .sail-2 {
    fill: var(--text-2);
  }
  .plumb {
    stroke: var(--muted);
    stroke-width: 1;
    stroke-dasharray: 4 5;
  }
  .arc {
    fill: none;
    stroke: var(--rust-hi);
    stroke-width: 2;
  }
  .heel {
    fill: var(--rust-hi);
    font-family: var(--mono);
    font-size: 16px;
  }
  .log {
    padding: 36px 40px;
    background: var(--hull);
    border-radius: 6px;
    font-family: var(--mono);
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-2);
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .d {
    color: var(--brass);
  }
  .q {
    color: var(--text);
  }
  hr {
    border: 0;
    height: 1px;
    background: var(--line);
    margin: 0;
  }
  .all {
    font-family: var(--sans);
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .journal .wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    .log {
      padding: 26px 22px;
      font-size: 14px;
    }
  }
</style>
