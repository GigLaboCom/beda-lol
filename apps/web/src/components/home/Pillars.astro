---
import { PILLARS, WORD } from '@beda/core';
import { t } from '../../i18n/ru';
---

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2 class="display">{t('pillars.title')}</h2>
      <p>{t('pillars.lead')}</p>
    </div>
    <div class="pillars">
      {
        WORD.map((letter, i) => (
          <div class:list={['pillar', { first: i < 2 }]}>
            <span class="tag">{i < 2 ? t('pillars.firstTag') : ''}</span>
            <span class="L" aria-hidden="true">
              {letter}
            </span>
            <b>{PILLARS[letter].name}</b>
            <span class="d">{PILLARS[letter].description}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillars {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }
  .pillar {
    padding: 26px 22px;
    background: var(--hull);
    border: 1px solid var(--line);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 290px;
    color: var(--text);
    text-decoration: none;
  }
  .pillar.first {
    border-color: var(--rust);
  }
  .tag {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--rust-hi);
    min-height: 1.4em;
  }
  .L {
    font-family: var(--display);
    font-weight: 900;
    font-size: 72px;
    line-height: 1;
    color: var(--brass);
  }
  b {
    font-weight: 600;
    font-size: 19px;
    hyphens: auto;
    overflow-wrap: break-word;
  }
  .d {
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 620px) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pillar {
      min-height: 0;
    }
    .L {
      font-size: 56px;
    }
  }
</style>
