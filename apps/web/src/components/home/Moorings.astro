---
import { type Key, t } from '../../i18n/ru';

type Icon = 'search' | 'type' | 'drop' | 'bolt' | 'nail' | 'book' | 'anchor' | 'triangle';

interface Mooring {
  id: string;
  icon: Icon;
  /** Built routes are links; everything else is a card marked «скоро». */
  href?: string;
  kind?: Key;
  dark?: boolean;
}

// Stage 1 builds the quiz and the name game; the rest arrive in later stages.
const moorings: Mooring[] = [
  { id: 'osmotr', icon: 'search', href: '/osmotr', kind: 'harbor.kindEntry' },
  { id: 'namer', icon: 'type', href: '/kak-nazovesh', kind: 'harbor.kindEntry' },
  { id: 'leak', icon: 'drop' },
  { id: 'storm', icon: 'bolt' },
  { id: 'tracker', icon: 'nail', dark: true },
  { id: 'log', icon: 'book' },
  { id: 'registry', icon: 'anchor' },
  { id: 'triangle', icon: 'triangle' },
];

const text = (id: string, part: 'title' | 'text' | 'meta') => t(`harbor.${id}.${part}` as Key);
---

<section class="section light" id="harbor">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="kicker">{t('harbor.kicker')}</p>
        <h2 class="display">{t('harbor.title')}</h2>
      </div>
    </div>
    <div class="moorings">
      {
        moorings.map((m) => {
          const Tag = m.href ? 'a' : 'div';
          return (
            <Tag class:list={['mooring', { dark: m.dark, soon: !m.href }]} href={m.href}>
              <div class="top">
                <svg
                  width="30"
                  height="30"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  class="icon"
                >
                  {m.icon === 'search' && (
                    <Fragment>
                      <circle cx="11" cy="11" r="6" />
                      <path d="M20 20l-4.5-4.5" />
                    </Fragment>
                  )}
                  {m.icon === 'type' && <path d="M4 7V5h16v2M12 5v14M9 19h6" />}
                  {m.icon === 'drop' && <path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z" />}
                  {m.icon === 'bolt' && <path d="M13 3L6 13h5l-1 8 7-10h-5z" />}
                  {m.icon === 'nail' && <path d="M8 3h8M12 3v13M12 16l-1.5 5h3z" />}
                  {m.icon === 'book' && (
                    <Fragment>
                      <path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3z" />
                      <path d="M5 17a3 3 0 0 1 3-3h11" />
                    </Fragment>
                  )}
                  {m.icon === 'anchor' && (
                    <Fragment>
                      <circle cx="12" cy="5" r="2" />
                      <path d="M12 7v14M5 13a7 7 0 0 0 14 0M8 11h8" />
                    </Fragment>
                  )}
                  {m.icon === 'triangle' && <path d="M12 4l9 16H3z" />}
                </svg>
                {m.kind ? (
                  <span class="kind">{t(m.kind)}</span>
                ) : (
                  <span class="soon-tag">{t('common.soon')}</span>
                )}
              </div>
              <h3>{text(m.id, 'title')}</h3>
              <p>{text(m.id, 'text')}</p>
              <span class="meta">{text(m.id, 'meta')}</span>
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  h2 {
    margin-top: 12px;
  }
  .moorings {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .mooring {
    min-height: 250px;
    padding: 28px;
    background: var(--canvas-2);
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    color: var(--ink);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.15s;
  }
  a.mooring:hover {
    color: var(--ink);
    transform: translateY(-3px);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .kind {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--brass-deep);
  }
  h3 {
    font-family: var(--display);
    font-weight: 700;
    font-size: 25px;
    margin: 0;
    line-height: 1.15;
  }
  p {
    margin: 0;
    font-size: 15px;
    color: var(--muted-ink);
  }
  .meta {
    margin-top: auto;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted-ink);
  }
  .soon-tag {
    font-family: var(--mono);
    font-size: 12px;
    padding: 2px 8px;
    border: 1px solid currentColor;
    border-radius: 3px;
  }
  .mooring.dark {
    background: var(--ink);
    color: var(--canvas);
  }
  .mooring.dark .icon {
    color: var(--brass);
  }
  .mooring.dark .kind {
    color: var(--brass);
  }
  .mooring.dark p,
  .mooring.dark .meta {
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .moorings {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .moorings {
      grid-template-columns: minmax(0, 1fr);
    }
    .mooring {
      min-height: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mooring {
      transition: none;
    }
  }
</style>
