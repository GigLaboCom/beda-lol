---
import {
  getLangFromUrl,
  getLocalizedPath,
  localeShort,
  locales,
  stripLocale,
  useTranslations,
} from '../i18n';
import { signInHref } from '../lib/auth/routes';
import HeaderAccount from './auth/HeaderAccount.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const path = Astro.url.pathname;
const home = getLocalizedPath('/', lang);
// Only routes that exist; the harbour and the journal are sections of the home page for now.
const nav = [
  { href: getLocalizedPath('/osmotr', lang), label: t('nav.osmotr') },
  { href: getLocalizedPath('/kak-nazovesh', lang), label: t('nav.namer') },
  { href: getLocalizedPath('/bukvy', lang), label: t('nav.letters') },
  { href: `${home}#harbor`, label: t('nav.harbor') },
  { href: `${home}#journal`, label: t('nav.journal') },
];

// Language switcher: the current page in each locale.
const basePath = stripLocale(path);
const languages = locales.map((l) => ({
  code: l,
  short: localeShort[l],
  href: getLocalizedPath(basePath, l),
  current: l === lang,
}));
---

<header class="site-head">
  <div class="wrap">
    <a class="logo" href={home} aria-label={t('head.logoLabel')}>
      <svg
        width="30"
        height="30"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
        class="logo-mark"
        ><circle cx="12" cy="12" r="7"></circle><circle cx="12" cy="12" r="2"></circle><path
          d="M12 2v5M12 17v5M2 12h5M17 12h5M4.9 4.9l3.5 3.5M15.6 15.6l3.5 3.5M4.9 19.1l3.5-3.5M15.6 8.4l3.5-3.5"
        ></path></svg
      >
      {t('site.name')}
    </a>
    <nav class="nav" aria-label={t('head.navLabel')}>
      {
        nav.map((item) => (
          <a href={item.href} aria-current={!item.href.includes('#') && path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="head-end">
      <nav class="lang-switch" aria-label={t('nav.language')}>
        {
          languages.map((l) => (
            <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.current ? 'true' : undefined}>
              {l.short}
            </a>
          ))
        }
      </nav>
      <HeaderAccount server:defer lang={lang} path={path}>
        <a class="head-account" slot="fallback" href={signInHref(lang, path)}>{t('head.signIn')}</a>
      </HeaderAccount>
      <a class="btn btn-line-brass head-cta" href="#subscribe">{t('head.cta')}</a>
    </div>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--tar);
    border-bottom: 1px solid var(--line);
  }
  .site-head .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text);
    text-decoration: none;
    font-family: var(--display);
    font-weight: 700;
    font-size: 23px;
  }
  .logo:hover {
    color: var(--text);
  }
  .logo-mark {
    color: var(--brass);
  }
  .nav {
    display: flex;
    gap: 28px;
    font-size: 15px;
  }
  .nav a {
    color: var(--text);
    text-decoration: none;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--brass);
  }
  .head-end {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 14px;
    font-weight: 600;
  }
  .lang-switch a {
    color: var(--muted);
    text-decoration: none;
    padding: 6px 8px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: 6px;
  }
  .lang-switch a:hover {
    color: var(--brass);
  }
  .lang-switch a[aria-current='true'] {
    color: var(--text);
  }
  /* Global: the link comes from the server island, outside this component's scope. */
  .head-end :global(.head-account) {
    color: var(--text);
    text-decoration: none;
    font-size: 15px;
    padding: 6px 8px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: 6px;
  }
  .head-end :global(.head-account:hover) {
    color: var(--brass);
  }
  .head-cta {
    min-height: 44px;
    padding: 0 18px;
    font-size: 15px;
  }
  @media (max-width: 980px) {
    .nav {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .head-cta {
      display: none;
    }
  }
</style>
