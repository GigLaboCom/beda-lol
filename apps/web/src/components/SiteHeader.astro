---
import { t } from '../i18n/ru';

const path = Astro.url.pathname;
// Only routes that exist; the harbour and the journal are sections of the home page for now.
const nav = [
  { href: '/osmotr', label: t('nav.osmotr') },
  { href: '/kak-nazovesh', label: t('nav.namer') },
  { href: '/bukvy', label: t('nav.letters') },
  { href: '/#harbor', label: t('nav.harbor') },
  { href: '/#journal', label: t('nav.journal') },
];
---

<header class="site-head">
  <div class="wrap">
    <a class="logo" href="/" aria-label={t('head.logoLabel')}>
      <svg
        width="30"
        height="30"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
        class="logo-mark"
        ><circle cx="12" cy="12" r="7"></circle><circle cx="12" cy="12" r="2"></circle><path
          d="M12 2v5M12 17v5M2 12h5M17 12h5M4.9 4.9l3.5 3.5M15.6 15.6l3.5 3.5M4.9 19.1l3.5-3.5M15.6 8.4l3.5-3.5"
        ></path></svg
      >
      {t('site.name')}
    </a>
    <nav class="nav" aria-label={t('head.navLabel')}>
      {
        nav.map((item) => (
          <a href={item.href} aria-current={!item.href.includes('#') && path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <a class="btn btn-line-brass head-cta" href="#subscribe">{t('head.cta')}</a>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 20;
    background: var(--tar);
    border-bottom: 1px solid var(--line);
  }
  .site-head .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text);
    text-decoration: none;
    font-family: var(--display);
    font-weight: 700;
    font-size: 23px;
  }
  .logo:hover {
    color: var(--text);
  }
  .logo-mark {
    color: var(--brass);
  }
  .nav {
    display: flex;
    gap: 28px;
    font-size: 15px;
  }
  .nav a {
    color: var(--text);
    text-decoration: none;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--brass);
  }
  .head-cta {
    min-height: 44px;
    padding: 0 18px;
    font-size: 15px;
  }
  @media (max-width: 980px) {
    .nav {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .head-cta {
      display: none;
    }
  }
</style>
