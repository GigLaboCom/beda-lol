---
import { fmt, getLangFromUrl, getLocalizedPath, htmlLang, useTranslations } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { authConfig } from '../../lib/auth/config';
import { allowSignIn } from '../../lib/auth/csp';
import { PROVIDER_NAMES } from '../../lib/auth/providers';
import { afterSignIn } from '../../lib/auth/routes';
import { legalPath } from '../../lib/legal';
/**
 * `/voiti` and `/en/voiti`: the sign-in forms. The route files send a visitor who is
 * already signed in on (`afterSignIn`); this renders the rest.
 */
import SignIn from '../auth/SignIn';
import '../../styles/auth.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cfg = authConfig();
const failed = Astro.url.searchParams.get('auth') === 'failed';
const deleted = Astro.url.searchParams.get('account') === 'deleted';
if (cfg) allowSignIn(Astro.csp, cfg);
// «GitHub, Google или X»: the buttons the page has.
const services = new Intl.ListFormat(htmlLang[lang], { type: 'disjunction' }).format(
  (cfg?.providers ?? []).map((p) => PROVIDER_NAMES[p]),
);
// «Входя, вы принимаете {rules} и {privacy}.» with the two placeholders as links.
const legalLinks = {
  '{rules}': { href: getLocalizedPath(legalPath('pravila'), lang), label: t('signin.rules') },
  '{privacy}': {
    href: getLocalizedPath(legalPath('konfidencialnost'), lang),
    label: t('signin.privacy'),
  },
} as const;
const legalParts = t('signin.legal')
  .split(/(\{rules\}|\{privacy\})/)
  .map((part) => (part in legalLinks ? legalLinks[part as keyof typeof legalLinks] : part));
const lead = services ? fmt(t('signin.lead'), { services }) : t('signin.leadEmail');
Astro.response.headers.set('cache-control', 'no-store');
---

<Base title={t('signin.title')} robots="noindex, follow">
  <div class="wrap auth-page">
    <h1 class="display">{t('signin.title')}</h1>
    {deleted && <p class="warn" role="status">{t('signin.deleted')}</p>}
    <p class="lead">{lead}</p>
    {failed && <p class="warn" role="alert">{t('auth.failed')}</p>}
    {cfg ? <SignIn client:load cfg={cfg} lang={lang} next={afterSignIn(Astro.url, lang)} /> : <p class="warn">{t('auth.off')}</p>}
    <p class="note" data-testid="signin-legal">
      {legalParts.map((part) => (typeof part === 'string' ? part : <a href={part.href}>{part.label}</a>))}
    </p>
  </div>
</Base>
