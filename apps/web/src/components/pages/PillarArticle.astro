---
import { render } from 'astro:content';
import { getPillars, letterIndex, WORD } from '@beda/core';
import Transom from '@beda/transom/Transom.astro';
import { getLangFromUrl, getLocalizedPath, htmlLang, useTranslations } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { type PillarEntry, pillarPath } from '../../lib/pillars';
import JsonLd from '../JsonLd.astro';

interface Props {
  entry: PillarEntry;
  prev?: PillarEntry;
  next?: PillarEntry;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const PILLARS = getPillars(lang);

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { letter, description, draft, slug } = entry.data;
const pillarName = PILLARS[letter].name;

// English long-form copy is not translated yet: show a marked stub, keep noindex.
const isEn = lang === 'en';
const title = isEn ? `${letter} — ${pillarName}` : entry.data.title;
const lead = isEn ? PILLARS[letter].description : description;
const ruArticle = getLocalizedPath(pillarPath(slug), 'ru');

const url = new URL(getLocalizedPath(pillarPath(slug), lang), Astro.site).href;
const home = new URL(getLocalizedPath('/', lang), Astro.site).href;
const index = new URL(getLocalizedPath('/bukvy', lang), Astro.site).href;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('site.name'), item: home },
      { '@type': 'ListItem', position: 2, name: t('letters.title'), item: index },
      { '@type': 'ListItem', position: 3, name: `${letter} — ${pillarName}`, item: url },
    ],
  },
];
if (!isEn) {
  graph.unshift({
    '@type': 'Article',
    headline: title,
    description: lead,
    inLanguage: htmlLang[lang],
    mainEntityOfPage: url,
    url,
    author: { '@type': 'Person', name: 'Денис' },
    publisher: { '@type': 'Organization', name: t('site.name'), url: home },
    image: new URL(`/og/bukvy/${slug}.png`, Astro.site).href,
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<Base
  title={`${title} — ${t('site.name')}`}
  description={lead}
  robots={isEn || draft ? 'noindex, follow' : undefined}
  ogType="article"
  ogImage={`/og/bukvy/${slug}.png`}
  ogImageAlt={title}
>
  <Fragment slot="head">
    <JsonLd data={jsonLd} />
  </Fragment>

  <article class="pillar-page">
    <div class="wrap">
      <nav class="crumbs" aria-label={t('letters.crumbs')}>
        <a href={getLocalizedPath('/', lang)}>{t('site.name')}</a>
        <span aria-hidden="true">/</span>
        <a href={getLocalizedPath('/bukvy', lang)}>{t('letters.title')}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{letter} — {pillarName}</span>
      </nav>
      <header>
        <Transom letters={WORD} highlight={letterIndex(letter)} lang={lang} />
        <h1 class="display">{title}</h1>
        <p class="lead">{lead}</p>
      </header>
      <div class="body">
        {
          isEn ? (
            <p class="stub">
              {t('pillar.stub')}{' '}
              <a href={ruArticle}>{t('pillar.stubLink')}</a>
            </p>
          ) : (
            <Content />
          )
        }
      </div>
      <aside class="cta">
        <p>{t('letters.cta')}</p>
        <a class="btn btn-brass btn-big" href={getLocalizedPath('/osmotr?from=bukvy', lang)}>
          {t('hero.cta')}
        </a>
      </aside>
      <nav class="pager" aria-label={t('letters.pager')}>
        {
          prev ? (
            <a rel="prev" href={getLocalizedPath(pillarPath(prev.data.slug), lang)}>
              ← {prev.data.letter} — {PILLARS[prev.data.letter].name}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a rel="next" href={getLocalizedPath(pillarPath(next.data.slug), lang)}>
              {next.data.letter} — {PILLARS[next.data.letter].name} →
            </a>
          )
        }
      </nav>
    </div>
  </article>
</Base>

<style>
  .pillar-page {
    padding: clamp(32px, 5vw, 56px) 0 clamp(56px, 8vw, 96px);
  }
  .pillar-page .wrap {
    max-width: 860px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--muted);
  }
  header {
    margin: 32px 0 40px;
  }
  header :global(.transom-wrap) {
    --ts: clamp(36px, 7vw, 64px);
    align-items: flex-start;
  }
  h1 {
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.05;
    margin: 36px 0 18px;
  }
  .lead {
    font-size: 19px;
    color: var(--text-2);
    margin: 0;
  }
  .body {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-2);
  }
  .body :global(h2) {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(26px, 3vw, 34px);
    color: var(--text);
    margin: 48px 0 16px;
  }
  .body :global(strong) {
    color: var(--text);
  }
  .body :global(li) {
    margin: 8px 0;
  }
  .stub {
    padding: 24px;
    background: var(--hull);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .cta {
    margin: 56px 0 40px;
    padding: 28px;
    background: var(--hull);
    border: 1px solid var(--line);
    border-radius: 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
    flex-wrap: wrap;
  }
  .cta p {
    margin: 0;
    font-size: 18px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
</style>
