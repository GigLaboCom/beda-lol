---
/**
 * Temporary CSS-only transom copied from the prototype (buildTransom + setTransom).
 * Replaced by the @beda/transom package in S08.
 */
interface Props {
  letters: string[];
  nails: number[];
}
const { letters, nails } = Astro.props;

const MOUNTS: Record<string, { pts: [number, number][]; hang: string }> = {
  П: {
    pts: [
      [0.1, 0.28],
      [0.6, 0.28],
      [0.1, 0.86],
      [0.6, 0.86],
    ],
    hang: '37deg',
  },
  О: {
    pts: [
      [0.09, 0.72],
      [0.09, 0.46],
      [0.64, 0.46],
      [0.64, 0.72],
    ],
    hang: '124deg',
  },
  Б: {
    pts: [
      [0.1, 0.28],
      [0.55, 0.28],
      [0.1, 0.86],
      [0.5, 0.86],
    ],
    hang: '34deg',
  },
  Е: {
    pts: [
      [0.1, 0.28],
      [0.54, 0.28],
      [0.1, 0.86],
      [0.54, 0.86],
    ],
    hang: '36deg',
  },
  Д: {
    pts: [
      [0.14, 0.28],
      [0.58, 0.28],
      [0.05, 0.93],
      [0.66, 0.93],
    ],
    hang: '30deg',
  },
  А: {
    pts: [
      [0.36, 0.31],
      [0.08, 0.88],
      [0.64, 0.88],
      [0.36, 0.7],
    ],
    hang: '6deg',
  },
};
const DEFAULT_MOUNT = { pts: MOUNTS.П?.pts ?? [], hang: '34deg' };

const slots = letters.map((ch, i) => {
  const m = MOUNTS[ch] ?? DEFAULT_MOUNT;
  const [ox, oy] = m.pts[0] ?? [0, 0];
  const sign = i % 2 ? 1 : -1;
  const count = nails[i] ?? 4;
  return {
    ch,
    count,
    style: `--ox:${ox}em;--oy:${oy}em;--hang:${m.hang};--drop:1.12em;--fx:${(sign * (0.04 + ((i * 37) % 10) / 70)).toFixed(3)}em;--fr:${sign * (6 + ((i * 53) % 12))}deg`,
    pts: m.pts,
  };
});
const shown = letters
  .map((ch, i) => (ch === ' ' ? ' ' : (nails[i] ?? 4) > 0 ? ch : 'пусто '))
  .join('');
---

<div class="transom-wrap">
  <div class="transom" role="img" aria-label={`Надпись на транце: ${shown}`}>
    {
      slots.map((s) =>
        s.ch === ' ' ? (
          <div class="slot space" />
        ) : (
          <div class:list={['slot', { hang: s.count === 1, fall: s.count <= 0 }]} style={s.style}>
            <span class="ghost" aria-hidden="true">{s.ch}</span>
            <span class="g" aria-hidden="true">{s.ch}</span>
            {s.pts.map(([x, y], k) => (
              <>
                <i class="hole" style={`left:${x}em;top:${y}em`} />
                <i class:list={['nail', { off: k >= s.count }]} style={`left:${x}em;top:${y}em`} />
              </>
            ))}
          </div>
        ),
      )
    }
  </div>
  <div class="shelf"></div>
</div>

<style>
  .transom-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: var(--ts, 112px);
  }
  .transom {
    position: relative;
    display: flex;
    justify-content: center;
    gap: 0.1em;
    padding: 0.46em 0.4em 0.5em;
    background: repeating-linear-gradient(
      180deg,
      var(--plank) 0,
      var(--plank) 0.4em,
      var(--seam) 0.4em,
      var(--seam) 0.42em
    );
    border-radius: 0.09em 0.09em 1.4em 1.4em / 0.09em 0.09em 0.75em 0.75em;
    box-shadow:
      inset 0 -0.15em 0.25em rgb(0 0 0 / 0.35),
      inset 0 0.05em 0 var(--plank-hi);
  }
  .shelf {
    width: 100%;
    max-width: 7em;
    height: 0.55em;
    margin-top: 0.52em;
    border-top: 0.09em solid var(--shelf);
    background: var(--hull);
  }
  .slot {
    position: relative;
    width: 0.75em;
    height: 1.07em;
  }
  .slot.space {
    width: 0.35em;
  }
  .g,
  .ghost {
    position: absolute;
    inset: 0;
    text-align: center;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1em;
    line-height: 1.07em;
    user-select: none;
  }
  .ghost {
    color: var(--plank-hi);
  }
  .g {
    color: var(--brass);
    text-shadow: 0 0.025em 0 var(--glyph-shadow);
    transform-origin: var(--ox) var(--oy);
    z-index: 2;
  }
  .slot.hang .g {
    transform: rotate(var(--hang));
  }
  .slot.fall .g {
    transform: translate(var(--fx), var(--drop)) rotate(var(--fr));
  }
  .hole,
  .nail {
    position: absolute;
    width: 0.072em;
    height: 0.072em;
    border-radius: 50%;
    margin: -0.036em 0 0 -0.036em;
  }
  .hole {
    background: var(--hole);
    transform: scale(0.72);
  }
  .nail {
    background: var(--brass-hi);
    box-shadow: 0 0.01em 0 var(--hole);
    z-index: 3;
  }
  .nail.off {
    transform: translateY(1.25em) translateX(-0.08em);
    opacity: 0;
  }
</style>
