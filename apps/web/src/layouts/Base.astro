---
import '@beda/tokens/tokens.css';
import '@beda/tokens/fonts.css';
import { displayFontUrl } from '@beda/tokens/preload';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  getLangFromUrl,
  getLocalizedPath,
  htmlLang,
  type Locale,
  locales,
  ogLocale,
  stripLocale,
  useTranslations,
} from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Path (or absolute URL) of the canonical page; defaults to the current path. */
  canonical?: string;
  /** e.g. "noindex, follow" for result and personal pages. */
  robots?: string;
  /** Share image path (1200×630), defaults to the home card. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** Override the locale (defaults to the one in the URL). */
  lang?: Locale;
  /** Emit hreflang alternate links (default true). Turn off for one-locale pages. */
  alternates?: boolean;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title = t('site.title'),
  description = t('site.description'),
  canonical = Astro.url.pathname,
  robots,
  // NOTE: OG/share images are Russian-only for now (translation on hold); both
  // locales reuse the same cards until the image story is decided.
  ogImage = '/og/default.png',
  ogImageAlt = t('og.defaultAlt'),
  ogType = 'website',
  alternates = true,
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// hreflang alternates: the same page in every locale, plus x-default → the default locale.
const basePath = stripLocale(Astro.url.pathname);
const localeAlternates = locales.map((l) => ({
  hreflang: htmlLang[l],
  href: new URL(getLocalizedPath(basePath, l), Astro.site).href,
}));
const xDefaultHref = new URL(getLocalizedPath(basePath, 'ru'), Astro.site).href;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="preload" href={displayFontUrl} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternates && (
        <>
          {localeAlternates.map((a) => (
            <link rel="alternate" hreflang={a.hreflang} href={a.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {robots && <meta name="robots" content={robots} />}
    <meta name="color-scheme" content="dark light" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">{t('a11y.skip')}</a>
    <SiteHeader />
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
