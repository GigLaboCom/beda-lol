---
import SignInPage from '../components/pages/SignInPage.astro';
import { getLangFromUrl } from '../i18n';
import { afterSignIn } from '../lib/auth/routes';

export const prerender = false;

if (Astro.locals.auth)
  return Astro.redirect(afterSignIn(Astro.url, getLangFromUrl(Astro.url)), 303);
---

<SignInPage />
