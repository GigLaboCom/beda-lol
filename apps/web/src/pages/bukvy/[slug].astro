---
import { render } from 'astro:content';
import { letterIndex, PILLARS, WORD } from '@beda/core';
import Transom from '@beda/transom/Transom.astro';
import JsonLd from '../../components/JsonLd.astro';
import { t } from '../../i18n/ru';
import Base from '../../layouts/Base.astro';
import { type PillarEntry, pillarPath, pillarsInOrder } from '../../lib/pillars';

export async function getStaticPaths() {
  const all = await pillarsInOrder();
  return all.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: { entry, prev: all[i - 1], next: all[i + 1] },
  }));
}

interface Props {
  entry: PillarEntry;
  prev?: PillarEntry;
  next?: PillarEntry;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { letter, title, description, draft, slug } = entry.data;
const url = new URL(pillarPath(slug), Astro.site).href;
const home = new URL('/', Astro.site).href;
const index = new URL('/bukvy', Astro.site).href;
const pillarName = PILLARS[letter].name;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description,
      inLanguage: 'ru',
      mainEntityOfPage: url,
      url,
      author: { '@type': 'Person', name: 'Денис' },
      publisher: { '@type': 'Organization', name: t('site.name'), url: home },
      image: new URL(`/og/bukvy/${slug}.png`, Astro.site).href,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('site.name'), item: home },
        { '@type': 'ListItem', position: 2, name: t('letters.title'), item: index },
        { '@type': 'ListItem', position: 3, name: `${letter} — ${pillarName}`, item: url },
      ],
    },
  ],
};
---

<Base
  title={`${title} — ${t('site.name')}`}
  description={description}
  robots={draft ? 'noindex, follow' : undefined}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(`/og/bukvy/${slug}.png`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <JsonLd data={jsonLd} />
  </Fragment>

  <article class="pillar-page">
    <div class="wrap">
      <nav class="crumbs" aria-label={t('letters.crumbs')}>
        <a href="/">{t('site.name')}</a>
        <span aria-hidden="true">/</span>
        <a href="/bukvy">{t('letters.title')}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{letter} — {pillarName}</span>
      </nav>
      <header>
        <Transom letters={WORD} highlight={letterIndex(letter)} />
        <h1 class="display">{title}</h1>
        <p class="lead">{description}</p>
      </header>
      <div class="body">
        <Content />
      </div>
      <aside class="cta">
        <p>{t('letters.cta')}</p>
        <a class="btn btn-brass btn-big" href="/osmotr?from=bukvy">{t('hero.cta')}</a>
      </aside>
      <nav class="pager" aria-label={t('letters.pager')}>
        {
          prev ? (
            <a rel="prev" href={pillarPath(prev.data.slug)}>
              ← {prev.data.letter} — {PILLARS[prev.data.letter].name}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a rel="next" href={pillarPath(next.data.slug)}>
              {next.data.letter} — {PILLARS[next.data.letter].name} →
            </a>
          )
        }
      </nav>
    </div>
  </article>
</Base>

<style>
  .pillar-page {
    padding: clamp(32px, 5vw, 56px) 0 clamp(56px, 8vw, 96px);
  }
  .pillar-page .wrap {
    max-width: 860px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--muted);
  }
  header {
    margin: 32px 0 40px;
  }
  header :global(.transom-wrap) {
    --ts: clamp(36px, 7vw, 64px);
    align-items: flex-start;
  }
  h1 {
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.05;
    margin: 36px 0 18px;
  }
  .lead {
    font-size: 19px;
    color: var(--text-2);
    margin: 0;
  }
  .body {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-2);
  }
  .body :global(h2) {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(26px, 3vw, 34px);
    color: var(--text);
    margin: 48px 0 16px;
  }
  .body :global(strong) {
    color: var(--text);
  }
  .body :global(li) {
    margin: 8px 0;
  }
  .cta {
    margin: 56px 0 40px;
    padding: 28px;
    background: var(--hull);
    border: 1px solid var(--line);
    border-radius: 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
    flex-wrap: wrap;
  }
  .cta p {
    margin: 0;
    font-size: 18px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
</style>
