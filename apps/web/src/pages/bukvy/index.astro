---
import { PILLARS } from '@beda/core';
import JsonLd from '../../components/JsonLd.astro';
import { t } from '../../i18n/ru';
import Base from '../../layouts/Base.astro';
import { pillarPath, pillarsInOrder } from '../../lib/pillars';

const all = await pillarsInOrder();
const allDrafts = all.every((e) => e.data.draft);
const home = new URL('/', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('site.name'), item: home },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('letters.title'),
      item: new URL('/bukvy', Astro.site).href,
    },
  ],
};
---

<Base
  title={`${t('letters.indexTitle')} — ${t('site.name')}`}
  description={t('letters.indexDescription')}
  robots={allDrafts ? 'noindex, follow' : undefined}
>
  <JsonLd slot="head" data={jsonLd} />
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{t('letters.title')}</p>
          <h1 class="display">{t('letters.indexTitle')}</h1>
        </div>
        <p>{t('pillars.lead')}</p>
      </div>
      <ol class="list">
        {
          all.map((e) => (
            <li>
              <a href={pillarPath(e.data.slug)}>
                <span class="L" aria-hidden="true">
                  {e.data.letter}
                </span>
                <span>
                  <b>{PILLARS[e.data.letter].name}</b>
                  <span class="d">{e.data.description}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  h1 {
    margin-top: 12px;
    font-size: clamp(34px, 4.2vw, 56px);
    line-height: 1.05;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .list a {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 24px;
    background: var(--hull);
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--text);
    text-decoration: none;
    height: 100%;
  }
  .list a:hover {
    border-color: var(--brass);
    color: var(--text);
  }
  .L {
    font-family: var(--display);
    font-weight: 900;
    font-size: 56px;
    line-height: 1;
    color: var(--brass);
    min-width: 0.8em;
  }
  b {
    display: block;
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .d {
    color: var(--muted);
    font-size: 15px;
  }
  @media (max-width: 760px) {
    .list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
