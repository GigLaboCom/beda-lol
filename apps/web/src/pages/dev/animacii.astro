---
/**
 * Dev bench: every transom animation on its own, with descriptions, and the
 * hang angle of every glyph (decision D9). Not linked anywhere, noindex,
 * disallowed in robots.txt and excluded from the sitemap.
 *
 * Boards are the real thing: `renderTransom` markup driven by `attachTransom`,
 * with the generated glyph data and the TIMELINE. Nothing is measured or
 * re-implemented here.
 */
import { BOARD_CHARSET, BREAKS, breakFrom, type Op } from '@beda/core';
import { fromOps, glyphFor, loadExt, renderTransom, TIMELINE } from '@beda/transom';
import Base from '../../layouts/Base.astro';
import '@beda/transom/transom.css';

await loadExt();

type Kind = 'nails' | 'hang' | 'play' | 'break-hang' | 'static';
let uid = 0;
/** One board: the markup plus what "play" does with it. */
function board(text: string, ops: Op[], kind: Kind) {
  const html = renderTransom({ state: fromOps(text, ops), debug: true, idPrefix: `ab${uid++}-` });
  return { html, kind, ops: JSON.stringify(ops) };
}
const fall = (...i: number[]): Op[] => i.map((n) => ({ i: n, fall: true }));

const demos = [
  {
    title: 'Гвозди вылетают',
    b: board('П', fall(0), 'nails'),
    text: 'Первыми уходят гвозди 3 и 2 (в падении — ещё и 1), по одному через 120 мс. Каждый падает вниз и гаснет, кривая ускоряющаяся. Гвоздь 0, шарнир, держит дольше всех.',
    params: `гвозди 3, 2, 1: t = ${TIMELINE.nailPops.join(', ')} мс · ${TIMELINE.nailPop} мс`,
  },
  {
    title: 'Вис и качание',
    b: board('П', fall(0), 'hang'),
    text: 'На последнем гвозде буква поворачивается вокруг шарнира, пока центр тяжести не окажется прямо под ним: θ = atan2(dx, dy), где (dx, dy) — вектор от шарнира к центру тяжести. Дорога к θ — затухающее качание: перелёт ×1,42, недолёт ×0,70, потом ×1,20, ×0,88, ×1,05 и покой.',
    params: `старт t = ${TIMELINE.hangAt} мс · ${TIMELINE.swing} мс · ease-out`,
  },
  {
    title: 'Падение на полку',
    b: board('П', fall(0), 'play'),
    text: 'После виса вылетает шарнир, и буква падает на полку с небольшим сносом и наклоном. Снос и наклон зависят только от номера слота, поэтому доска выглядит одинаково на сайте, в картинке для шеринга и без JavaScript.',
    params: `t = ${TIMELINE.fallAt} мс · ${TIMELINE.fall} мс · cubic-bezier(.55, 0, 1, .45)`,
  },
  {
    title: 'Круглая буква опрокидывается',
    b: board('О', fall(0), 'hang'),
    text: 'У круглых букв (O Q C G S О С Э Ю Ф) гвозди стоят клёпками по овалу, а шарнир — нижняя левая клёпка. Центр тяжести оказывается выше шарнира, поэтому буква переворачивается больше чем на 120°.',
    params: `та же формула θ; для О θ = ${glyphFor('О')?.hang}°`,
  },
  {
    title: 'Надлом: дрожь и падение куска',
    b: board('Д', [{ i: 0, brk: 'Д>Л' }], 'play'),
    text: 'Кусок буквы (многоугольник из карты надломов) дрожит на месте и падает на полку, кувыркаясь. На доске остаётся другая буква: Д → Л. На месте куска проступает след на дереве.',
    params: `дрожь t = 0, ${TIMELINE.crack} мс · падение t = ${TIMELINE.pieceDropAt} мс, ${TIMELINE.pieceDrop} мс`,
  },
  {
    title: 'Остаток повисает',
    b: board('Т', [{ i: 0, brk: 'Т>Г' }], 'break-hang'),
    text: 'Сценарий для проверки: после надлома у остатка вылетают гвозди, и он повисает. Угол остатка считается по его собственному центру тяжести, без куска. Гвозди остатка стоят только на нём самом: для Т>Г шарнир — на перекладине сразу за сколом.',
    params: 'надлом, затем гвозди остатка и вис',
  },
  {
    title: 'Целое слово: ДЕНЬГИ → ЛЕНЬ',
    b: board('ДЕНЬГИ', [{ i: 0, brk: 'Д>Л' }, ...fall(4, 5)], 'play'),
    text: 'Операции над словом идут по порядку, каждая по своему сценарию. Здесь надлом Д, потом падение Г и И.',
    params: `шаг операций ${TIMELINE.opGap} мс`,
  },
  {
    title: 'Целое слово: ПОБЕДА → БЕДА',
    b: board('ПОБЕДА', fall(0, 1), 'play'),
    text: 'Главная шутка рубрики. П и О срываются целиком, П висит на верхнем левом гвозде, О — на нижней левой клёпке.',
    params: `шаг операций ${TIMELINE.opGap} мс`,
  },
];

const chars = Array.from(BOARD_CHARSET);
const group = (ch: string) =>
  /\p{Script=Cyrillic}/u.test(ch) ? 'ru' : /\p{Script=Latin}/u.test(ch) ? 'en' : 'num';
const letters = chars.filter((ch) => glyphFor(ch)?.falls);
const fixed = chars.filter((ch) => !glyphFor(ch)?.falls);
const deg = (n: number | undefined) => `${(n ?? 0).toFixed(1).replace('.', ',')}°`;
const hex = (ch: string) => (ch.codePointAt(0) ?? 0).toString(16).toUpperCase().padStart(4, '0');
---

<Base title="Анимации транца — стенд" robots="noindex, nofollow">
  <div class="wrap ab" id="ab">
    <h1 class="display">Анимации транца</h1>
    <p class="lead">
      Каждая анимация отдельно, с описанием, и угол виса каждой буквы. Доски — настоящий транец
      сайта: SVG-контуры из файла шрифта, гвозди, шарнир и угол посчитаны при сборке
      (<code>task transom:glyphs</code>), движение — контроллер <code>attachTransom</code>.
    </p>

    <div class="controls" role="group" aria-label="Управление">
      <button class="btn btn-brass" type="button" id="ab-play">Проиграть всё видимое</button>
      <button class="btn" type="button" id="ab-reset">Прибить обратно</button>
      <label><input type="checkbox" id="ab-slow" /> Замедлить ×2,5</label>
      <label><input type="checkbox" id="ab-debug" /> Шарнир, отвес, центр тяжести</label>
      <label><input type="checkbox" id="ab-still" /> Сразу конечное состояние</label>
    </div>

    <section>
      <h2 class="display">Как читать отладку</h2>
      <ul class="legend">
        <li><span class="sw sw-hinge"></span> шарнир — гвоздь 0, вокруг него буква поворачивается, и отвес — вертикаль вниз от него;</li>
        <li><span class="sw sw-cen"></span> центр тяжести (для целой буквы — точный, по контуру; для остатка — без куска). Он поворачивается вместе с буквой;</li>
        <li><span class="sw sw-poly"></span> граница куска при надломе; пунктир — ячейка буквы.</li>
      </ul>
      <p>Проверка угла: когда буква повисла, центр тяжести должен лечь на отвес.</p>
    </section>

    <section>
      <h2 class="display">Анимации по отдельности</h2>
      <div class="demos">
        {
          demos.map((d) => (
            <article class="demo">
              <div class="stage" data-kind={d.b.kind} data-ops={d.b.ops} set:html={d.b.html} />
              <div>
                <h3>{d.title}</h3>
                <p>{d.text}</p>
                <p class="mono params">{d.params}</p>
                <button class="btn btn-sm" type="button" data-play>Проиграть</button>
              </div>
            </article>
          ))
        }
      </div>
      <h3>Таймлайн (docs/09-transom-falls-component.md §4, <code>timeline.ts</code>)</h3>
      <table class="mono">
        <thead><tr><th>Сценарий</th><th>t, мс</th><th>Событие</th></tr></thead>
        <tbody>
          <tr><td>падение</td><td>{TIMELINE.nailPops.join(', ')}</td><td>гвозди 3, 2, 1 вылетают ({TIMELINE.nailPop} мс)</td></tr>
          <tr><td>падение</td><td>{TIMELINE.hangAt}</td><td>вис: поворот к θ с затухающим качанием, {TIMELINE.swing} мс</td></tr>
          <tr><td>падение</td><td>{TIMELINE.fallAt}</td><td>вылетает шарнир, буква падает на полку, {TIMELINE.fall} мс</td></tr>
          <tr><td>надлом</td><td>0</td><td>дрожь куска, {TIMELINE.crack} мс</td></tr>
          <tr><td>надлом</td><td>{TIMELINE.pieceDropAt}</td><td>кусок падает на полку, кувыркаясь, {TIMELINE.pieceDrop} мс</td></tr>
          <tr><td>слово</td><td>+{TIMELINE.opGap}</td><td>следующая операция</td></tr>
        </tbody>
      </table>
      <p>Все длительности умножаются на <code>--k</code> (1 обычно, 2,5 медленно). При <code>prefers-reduced-motion</code> сразу конечное состояние.</p>
    </section>

    <section>
      <h2 class="display">Углы виса: все буквы и цифры (D9)</h2>
      <p>
        Все {letters.length} символов, которые могут падать: гвозди притянуты к металлу, центр
        тяжести точно по контуру. Шарнир можно переопределить для отдельной буквы в
        <code>packages/transom/glyphs.config.ts</code> (<code>hinges</code>).
      </p>
      <div class="filter" role="group" aria-label="Фильтр">
        <button class="btn btn-sm" type="button" data-filter="all" aria-pressed="true">Все</button>
        <button class="btn btn-sm" type="button" data-filter="ru" aria-pressed="false">Кириллица</button>
        <button class="btn btn-sm" type="button" data-filter="en" aria-pressed="false">Латиница</button>
        <button class="btn btn-sm" type="button" data-filter="num" aria-pressed="false">Цифры</button>
      </div>
      <div class="grid">
        {
          letters.map((ch) => {
            const b = board(ch, fall(0), 'hang');
            return (
              <article class="card" data-group={group(ch)}>
                <h3 class="display">{ch}</h3>
                <div class="stage" data-kind={b.kind} data-ops={b.ops} set:html={b.html} />
                <p class="mono small">θ = {deg(glyphFor(ch)?.hang)} · U+{hex(ch)}</p>
                <button class="btn btn-sm" type="button" data-play>Проиграть</button>
              </article>
            );
          })
        }
      </div>
    </section>

    <section>
      <h2 class="display">Надломы: кусок и остаток</h2>
      <p>Кусок откалывается и падает. Потом у остатка вылетают гвозди, и он повисает: угол остатка считается без куска.</p>
      <div class="grid">
        {
          BREAKS.map((key) => {
            const b = board(breakFrom(key), [{ i: 0, brk: key }], 'break-hang');
            return (
              <article class="card" data-group="brk">
                <h3 class="display">{key.replace('>', ' → ')}</h3>
                <div class="stage" data-kind={b.kind} data-ops={b.ops} set:html={b.html} />
                <p class="mono small">остаток: θ = {deg(glyphFor(breakFrom(key))?.breaks?.[key]?.hang)}</p>
                <button class="btn btn-sm" type="button" data-play>Проиграть</button>
              </article>
            );
          })
        }
      </div>
    </section>

    <section>
      <h2 class="display">Знаки: прибиты насовсем</h2>
      <p>
        Знаки препинания и символы ({fixed.length}) рисуются, но не падают и не ломаются. Гвоздей по
        размеру: мелкий знак — один гвоздь в центре, узкий — два по концам, крупный — четыре.
      </p>
      <div class="grid grid-fixed">
        {
          fixed.map((ch) => {
            const b = board(ch, [], 'static');
            return (
              <article class="card" data-group="fixed">
                <div class="stage" data-kind={b.kind} data-ops={b.ops} set:html={b.html} />
                <p class="mono small">{ch} · {glyphFor(ch)?.nails.length} гв.</p>
              </article>
            );
          })
        }
      </div>
    </section>
  </div>
</Base>

<style is:global>
  .ab {
    padding-block: 32px 64px;
  }
  .ab section {
    margin-top: 40px;
  }
  .ab .lead {
    max-width: 44em;
    color: var(--text-2);
  }
  .ab .controls,
  .ab .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    align-items: center;
    margin-top: 20px;
  }
  .ab .controls label {
    display: flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
  }
  .ab .btn-sm {
    min-height: 36px;
    padding: 0 12px;
    font-size: 14px;
  }
  .ab .filter [aria-pressed="true"] {
    border-color: var(--brass);
    color: var(--brass);
  }
  .ab .legend {
    list-style: none;
    padding: 0;
  }
  .ab .legend li {
    margin: 6px 0;
  }
  .ab .sw {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    vertical-align: middle;
  }
  .ab .sw-hinge {
    background: var(--sea-muted);
  }
  .ab .sw-cen {
    background: var(--ok-ink);
  }
  .ab .sw-poly {
    border-radius: 0;
    border: 2px solid var(--rust);
  }
  .ab .demos {
    display: grid;
    gap: 16px;
  }
  .ab .demo {
    display: grid;
    gap: 16px;
    padding: 16px;
    background: var(--hull);
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  @media (min-width: 760px) {
    .ab .demo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-items: center;
    }
  }
  .ab .demo h3 {
    margin: 0 0 8px;
  }
  .ab .params {
    font-size: 13px;
    color: var(--muted);
  }
  .ab .stage {
    min-width: 0;
    padding-bottom: 8px;
  }
  .ab .demo .transom-wrap {
    --ts: 72px;
  }
  .ab .card .transom-wrap {
    --ts: 44px;
  }
  .ab .grid-fixed .transom-wrap {
    --ts: 32px;
  }
  .ab table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .ab th,
  .ab td {
    text-align: left;
    padding: 6px 8px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .ab .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 14px;
    margin-top: 16px;
  }
  .ab .grid.grid-fixed {
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  }
  .ab .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
    background: var(--hull);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .ab .card[hidden] {
    display: none;
  }
  .ab .card h3 {
    margin: 0;
    font-size: 28px;
  }
  .ab .small {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
  }
</style>

<script>
  import type { Op } from '@beda/core';
  import { attachTransom, type TransomController } from '@beda/transom/client';

  const root = document.getElementById('ab');
  const flag = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.checked;
  const stages = [...document.querySelectorAll<HTMLElement>('.ab .stage')].map((el) => {
    const board = el.querySelector('[data-transom]');
    return {
      el,
      tr: board ? attachTransom(board) : null,
      kind: el.dataset.kind ?? 'static',
      ops: JSON.parse(el.dataset.ops ?? '[]') as Op[],
    };
  });
  type Stage = (typeof stages)[number];

  /** Leave `n` nails on slot 0: one hangs it, two only pop nails 3 and 2. */
  function nailsOnly(tr: TransomController, n: number, still: boolean) {
    tr.reset();
    const slots = tr.state.slots.map((s, i) => (i === 0 ? { ...s, nails: n } : s));
    tr.set({ ...tr.state, slots }, { animate: !still });
  }

  function play({ tr, kind, ops }: Stage) {
    if (!tr) return;
    const still = !!flag('ab-still');
    const k = flag('ab-slow') ? 2.5 : 1;
    if (kind === 'nails') nailsOnly(tr, 2, still);
    else if (kind === 'hang') nailsOnly(tr, 1, still);
    else if (kind === 'play' || kind === 'break-hang') {
      const then = () => {
        if (kind !== 'break-hang') return;
        const slots = tr.state.slots.map((s) => ({ ...s, nails: 1 }));
        tr.set({ ...tr.state, slots }, { animate: !still });
      };
      if (still) {
        tr.finalState(ops);
        then();
      } else tr.play(ops, { k, onDone: then });
    }
  }

  const visible = () => stages.filter((s) => !s.el.closest('[hidden]'));
  for (const b of document.querySelectorAll<HTMLButtonElement>('.ab [data-play]')) {
    b.addEventListener('click', () => {
      const box = b.closest('.demo, .card');
      for (const s of stages) if (box?.contains(s.el)) play(s);
    });
  }
  document.getElementById('ab-play')?.addEventListener('click', () => visible().forEach(play));
  document.getElementById('ab-reset')?.addEventListener('click', () => {
    for (const s of visible()) s.tr?.reset();
  });
  document.getElementById('ab-debug')?.addEventListener('change', () => {
    for (const s of stages) s.tr?.debug(!!flag('ab-debug'));
  });

  for (const f of document.querySelectorAll<HTMLButtonElement>('.ab [data-filter]')) {
    f.addEventListener('click', () => {
      const v = f.dataset.filter;
      for (const x of document.querySelectorAll('.ab [data-filter]')) {
        x.setAttribute('aria-pressed', String(x === f));
      }
      for (const c of document.querySelectorAll<HTMLElement>('.ab .card')) {
        c.hidden = !(v === 'all' || c.dataset.group === v);
      }
    });
  }

  // For automated checks: after an instant hang, how far (screen px) each
  // centroid lies from the plumb line through its hinge.
  (window as unknown as { abPlumb: () => number[] }).abPlumb = () =>
    [...(root?.querySelectorAll('.layer-main > .slot.hang') ?? [])].flatMap((s) => {
      const c = s.querySelector('.d-cen');
      const svg = s.closest('svg');
      const h = svg?.querySelector(`.layer-dbg > .slot.${s.classList[1]} .d-hinge`);
      if (!c || !h) return [];
      const a = c.getBoundingClientRect();
      const b = h.getBoundingClientRect();
      return [Math.abs(a.left + a.width / 2 - (b.left + b.width / 2))];
    });
</script>
