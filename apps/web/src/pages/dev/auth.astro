---
/**
 * Dev bench for sign-in (S16–S19): what the server reads from the session cookies,
 * `/api/me` called from the server and from the browser, with the same sign-in and
 * sign-out forms as `/voiti` and `/kabinet`. Not linked anywhere,
 * noindex, disallowed in robots.txt, excluded from the sitemap (the /dev rule).
 */
import AuthBench from '../../components/auth/AuthBench';
import SignIn from '../../components/auth/SignIn';
import SignOut from '../../components/auth/SignOut.astro';
import { fmt, getLangFromUrl, useTranslations } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { authConfig } from '../../lib/auth/config';
import { allowSignIn } from '../../lib/auth/csp';
import { apiFromServer } from '../../lib/auth/server';
import '../../styles/auth.css';

export const prerender = false;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cfg = authConfig();
const auth = Astro.locals.auth;
const me = await apiFromServer(Astro.locals, '/api/me');
const failed = Astro.url.searchParams.get('auth') === 'failed';
if (cfg) allowSignIn(Astro.csp, cfg);
Astro.response.headers.set('cache-control', 'no-store');
---

<Base title={t('authdev.title')} robots="noindex, nofollow">
  <div class="wrap auth-page">
    <h1 class="display">{t('authdev.title')}</h1>
    <p class="lead">{t('authdev.lead')}</p>
    {failed && <p class="warn" role="alert">{t('auth.failed')}</p>}
    {
      cfg ? (
        <>
          <section class="panel">
            <h2 class="sect mono">{t('authdev.server')}</h2>
            <p data-testid="server-auth">
              {auth ? fmt(t('authdev.signedIn'), { who: auth.email ?? auth.userId }) : t('authdev.signedOut')}
            </p>
            <p class="mono">{fmt(t('authdev.serverMe'), { status: me.status })}</p>
            <pre class="mono" data-testid="server-me">{JSON.stringify(me.body, null, 2)}</pre>
          </section>
          {auth ? (
            <div class="actions">
              <SignOut next={Astro.url.pathname} />
            </div>
          ) : (
            <SignIn client:load cfg={cfg} lang={lang} next={Astro.url.pathname} />
          )}
          <AuthBench client:load cfg={cfg} lang={lang} />
        </>
      ) : (
        <p class="warn">{t('auth.off')}</p>
      )
    }
  </div>
</Base>
