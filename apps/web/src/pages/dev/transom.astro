---
/**
 * Visual check page for the transom (S08, v2 in S08c). Not linked anywhere,
 * noindex, disallowed in robots.txt and excluded from the sitemap. Every
 * animation on its own: /dev/animacii.
 */
import { type Op, WORD } from '@beda/core';
import { fromOps, glyphFor } from '@beda/transom';
import Transom from '@beda/transom/Transom.astro';
import Base from '../../layouts/Base.astro';

const counts = [4, 1, 0] as const;
const combos = counts.flatMap((p) => counts.map((o) => [p, o, 4, 4, 4, 4]));
const latin = Array.from('BUG TRACKER PRO');
const hang = (ch: string) => glyphFor(ch)?.hang?.toFixed(1).replace('.', ',') ?? '—';
const gags: { text: string; ops: Op[] }[] = [
  {
    text: 'ДЕНЬГИ',
    ops: [
      { i: 0, brk: 'Д>Л' },
      { i: 4, fall: true },
      { i: 5, fall: true },
    ],
  },
  {
    text: 'ВЗЛЁТ',
    ops: [
      { i: 0, fall: true },
      { i: 1, fall: true },
      { i: 4, brk: 'Т>Г' },
    ],
  },
  {
    text: 'BETA',
    ops: [
      { i: 0, brk: 'B>P' },
      { i: 3, fall: true },
    ],
  },
];
---

<Base title="Транец — стенд" robots="noindex, nofollow">
  <div class="wrap bench">
    <h1 class="display">Транец: стенд</h1>
    <p class="kicker">
      П и О: 4, 1, 0 гвоздей. Висящая П ≈ {hang('П')}°, О опрокидывается по часовой ≈ {hang('О')}° вокруг
      нижней левой клёпки. Углы посчитаны при сборке из шрифта.
    </p>
    <label class="mono"><input type="checkbox" id="debug" /> Шарнир, отвес, центр тяжести</label>
    <div class="grid">
      {
        combos.map((nails) => (
          <figure>
            <Transom letters={WORD} nails={nails} debug />
            <figcaption class="mono">{nails.join(' ')}</figcaption>
          </figure>
        ))
      }
    </div>
    <h2 class="display">Длинное латинское название</h2>
    <div class="latin">
      <Transom letters={latin} nails={latin.map((_, i) => (i % 5 === 0 ? 0 : i % 3 === 0 ? 1 : 4))} debug />
    </div>
    <h2 class="display">Надломы: Д → Л, Т → Г, B → P</h2>
    <div class="grid">
      {
        gags.map(({ text, ops }) => (
          <figure class="gag" data-ops={JSON.stringify(ops)}>
            <Transom state={fromOps(text, ops)} debug />
            <figcaption>
              <button class="btn btn-sm" type="button" data-play>
                Проиграть {text}
              </button>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <h2 class="display">Анимация</h2>
    <div class="live"><Transom letters={WORD} id="live" /></div>
    <p><button class="btn" type="button" id="play">Проиграть П → 1, О → 0</button></p>
  </div>
</Base>

<script>
  import type { Op } from '@beda/core';
  import { attachTransom } from '@beda/transom/client';

  const boards = [...document.querySelectorAll<HTMLElement>('.bench [data-transom]')].map((el) => ({
    el,
    tr: attachTransom(el),
  }));
  document.getElementById('debug')?.addEventListener('change', (e) => {
    for (const { tr } of boards) tr.debug((e.target as HTMLInputElement).checked);
  });
  for (const fig of document.querySelectorAll<HTMLElement>('.gag')) {
    const board = boards.find((b) => fig.contains(b.el));
    const ops = JSON.parse(fig.dataset.ops ?? '[]') as Op[];
    fig.querySelector('[data-play]')?.addEventListener('click', () => board?.tr.play(ops));
  }
  const live = boards.find((b) => b.el.id === 'live')?.tr;
  document.getElementById('play')?.addEventListener('click', () => {
    if (!live) return;
    live.set([4, 4, 4, 4, 4, 4], { animate: false });
    setTimeout(() => live.set([1, 4, 4, 4, 4, 4]), 300);
    setTimeout(() => live.set([1, 0, 4, 4, 4, 4]), 1800);
  });
</script>

<style>
  .bench {
    padding-block: 48px 80px;
  }
  .bench h2 {
    font-size: 28px;
    margin: 48px 0 16px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 32px 24px;
    margin-top: 32px;
  }
  figure {
    margin: 0;
  }
  figure :global(.transom-wrap) {
    --ts: 56px;
  }
  .latin :global(.transom-wrap) {
    --ts: min(48px, 5.5vw);
  }
  .live :global(.transom-wrap) {
    --ts: 64px;
  }
  figcaption {
    text-align: center;
    color: var(--muted);
    margin-top: 8px;
  }
</style>
