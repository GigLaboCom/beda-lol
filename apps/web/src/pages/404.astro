import { getLangFromUrl, useTranslations } from '../i18n';
import Base from '../layouts/Base.astro';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Base title={t('notFound.pageTitle')} robots="noindex" alternates={false}>
  <NotFound />
</Base>
