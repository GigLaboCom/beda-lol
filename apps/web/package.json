{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check",
    "test": "vitest run",
    "e2e": "playwright test",
    "og": "tsx scripts/og.ts"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/preact": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@beda/brand": "workspace:*",
    "@beda/core": "workspace:*",
    "@beda/tokens": "workspace:*",
    "@beda/transom": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "astro": "7.3.5",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.4",
    "satori": "0.33.5",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "nx": {
    "targets": {
      "og": {
        "cache": true,
        "inputs": [
          "{projectRoot}/scripts/og.ts",
          "{projectRoot}/src/content/pillars/**/*",
          "{workspaceRoot}/packages/core/src/**/*",
          "{workspaceRoot}/packages/transom/src/**/*",
          "{workspaceRoot}/packages/tokens/src/tokens.css",
          "{workspaceRoot}/packages/tokens/src/read.ts",
          "{workspaceRoot}/packages/tokens/package.json",
          "{workspaceRoot}/pnpm-lock.yaml"
        ],
        "outputs": [
          "{projectRoot}/public/og"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          "og"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/deploy/scripts/supabase-setup.sh",
          "{workspaceRoot}/supabase/config.toml"
        ]
      }
    }
  }
}
